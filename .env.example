# BytePlus ModelArk / Seedance (secret serveur, ne jamais préfixer par NEXT_PUBLIC_)
ARK_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-260128
BYTEPLUS_ENABLED_MODELS=dreamina-seedance-2-0-260128
# Surcharges/ajouts Rudyo optionnels: {"model-id":{"720p":20,"1080p":50}}
SEEDANCE_CREDIT_RATES_JSON=
BYTEPLUS_VIDEO_RESOLUTION=720p
BYTEPLUS_VIDEO_RATIO=16:9
BYTEPLUS_GENERATE_AUDIO=false
BYTEPLUS_WATERMARK=false
# Tarifs vérifiés uniquement, au format JSON {"model-id": dollars_par_million_de_tokens}
BYTEPLUS_USD_PER_MILLION_TOKENS_BY_MODEL=
USD_TO_EUR_RATE=

# Worker HTTPS séparé pour les rendus FFmpeg longs
MONTAGE_MAX_ATTEMPTS=3
MONTAGE_WORKER_OFFLINE_SECONDS=90
MONTAGE_WORKER_URL=
MONTAGE_WORKER_SECRET=
WORKER_SHARED_SECRET=
WORKER_MOCK_MODE=true
RAILWAY_DOCKERFILE_PATH=Dockerfile.worker

# Application et authentification serveur
DATABASE_URL=
APP_BASE_URL=https://rudyoai.com
AUTH_SECRET=
# Ancien nom accepté uniquement hors production pendant la transition
AUTH_COOKIE_SECRET=
USE_LOCAL_SESSION=false
INITIAL_CREDITS=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rudyo AI <connexion@example.com>
CONTACT_EMAIL_TO=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
BETA_TESTS_ENABLED=false
ENABLE_LEGACY_GENERATE_VIDEOS=false

# Stockage persistant recommandé en production
BLOB_READ_WRITE_TOKEN=
CLOUD_STORAGE_PREFIX=rudyo-video-studio

# Limites d’import (Mo sauf le nombre de fichiers)
MAX_IMAGE_UPLOAD_MB=20
MAX_AUDIO_UPLOAD_MB=100
MAX_VIDEO_UPLOAD_MB=250
MAX_FILES_PER_PROJECT=100
MAX_USER_STORAGE_MB=5120
# Mêmes valeurs exposées au navigateur pour le rejet avant envoi
NEXT_PUBLIC_MAX_IMAGE_UPLOAD_MB=20
NEXT_PUBLIC_MAX_AUDIO_UPLOAD_MB=100
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=250

# Administration sécurisée (serveur uniquement)
ADMIN_EMAILS=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
E2E_MONTAGE_TEST_ENABLED=false
E2E_TEST_RETENTION_HOURS=24
# Offre Clip TikTok (100 crédits = 1 EUR)
TIKTOK_OFFER_ENABLED=true
CLIP_LONG_ENABLED=true
CLIP_PREMIUM_ENABLED=true
TIKTOK_SEEDANCE_MODEL_ID=dreamina-seedance-2-0-mini-260615
TIKTOK_PROVIDER_COST_EUR_PER_SECOND=0.072
TIKTOK_WORKER_COST_EUR=0.1
TIKTOK_STORAGE_COST_EUR=0.02
TIKTOK_RETRY_RESERVE_EUR=2
TIKTOK_MIN_MARGIN_EUR=0.5
