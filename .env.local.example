NODE_ENV=development
DATABASE_URL=postgresql://rudyo_local@127.0.0.1:55432/rudyo_worker_local?schema=public
# La base locale doit utiliser timezone=UTC pour aligner les leases PostgreSQL et les dates Prisma.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=local-auth-secret-change-me-32-characters
USE_LOCAL_SESSION=false

WORKER_MOCK_MODE=true
MONTAGE_WORKER_URL=http://localhost:4001
MONTAGE_WORKER_SECRET=local-worker-secret-change-me-32-chars
WORKER_SHARED_SECRET=local-worker-secret-change-me-32-chars
MONTAGE_WORKER_OFFLINE_SECONDS=90
PORT=4001

STRIPE_MOCK_MODE=true
STRIPE_WEBHOOK_SECRET=local-stripe-webhook-change-me-32-chars
BYTEPLUS_MOCK_MODE=true
STORAGE_MOCK_MODE=true
LOCAL_STORAGE_ROOT=./media
BLOB_READ_WRITE_TOKEN=

FFMPEG_PATH=./node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe
FFPROBE_PATH=./node_modules/@ffprobe-installer/win32-x64/ffprobe.exe
