generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  STARTER
  CREATOR
  STUDIO
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum TransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
  RESERVATION
}

enum TransactionStatus {
  PENDING
  RESERVED
  CONFIRMED
  REFUNDED
  CANCELED
}

enum CreditAction {
  STORYBOARD_SIMPLE
  STORYBOARD_COMPLETE
  PROMPTS_VIDEO
  SCRIPT_VOICEOVER
  SUBTITLES
  EXPORT_PDF
  EXPORT_TXT
  CLIP_PACK
  OTHER
}

enum VideoProjectStatus {
  DRAFT
  ACTIVE
  GENERATING
  RENDERING
  COMPLETED
  ARCHIVED
}

enum ClipPlan {
  TIKTOK
  LONG
  PREMIUM
  CUSTOM
}

enum MediaAssetType {
  AUDIO
  ARTIST_PORTRAIT
  ARTIST_PROFILE_LEFT
  ARTIST_PROFILE_RIGHT
  ARTIST_FULL_BODY
  REFERENCE_IMAGE
  REFERENCE_VIDEO
  DECOR
  OUTFIT
  FIRST_FRAME
  LAST_FRAME
  CONSENT_DOCUMENT
  GENERATED_VIDEO
  THUMBNAIL
  FINAL_EXPORT
}

enum StoryboardSceneStatus {
  DRAFT
  READY
  SUBMITTED
  QUEUED
  RUNNING
  COMPLETED
  REJECTED
  FAILED
  CANCELED
}

enum GenerationTaskStatus {
  PENDING
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum FinalExportStatus {
  DRAFT
  QUEUED
  RENDERING
  COMPLETED
  FAILED
  CANCELED
}

enum MontageJobStatus {
  QUEUED
  CLAIMED
  DOWNLOADING
  PREPARING
  RENDERING
  UPLOADING
  SUCCEEDED
  RETRYING
  FAILED
  REFUNDED
}

enum ClipWorkerJobStatus {
  QUEUED
  CLAIMED
  PREPARING
  RENDERING
  UPLOADING
  SUCCEEDED
  RETRYING
  FAILED
  REFUNDED
}

enum WorkerHealthStatus {
  ONLINE
  DEGRADED
  STOPPING
}

enum SystemTestStatus {
  PREPARING
  QUEUED
  RUNNING
  VERIFYING
  SUCCEEDED
  FAILED
  CLEANED
}

enum SystemTestScenario {
  SUCCESS
  INVALID_VIDEO
  MISSING_AUDIO
  INTERRUPTED_WORKER
  EXPIRED_LEASE
  STORAGE_FAILURE
  DOUBLE_CLAIM
  IDEMPOTENCY_REPLAY
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String?
  credits              Int                 @default(0)
  plan                 UserPlan            @default(FREE)
  creditsTotal         Int                 @default(0)
  creditsUsed          Int                 @default(0)
  creditsRemaining     Int                 @default(0)
  monthlyLimit         Int                 @default(0)
  monthlyUsed          Int                 @default(0)
  billingStatus        BillingStatus       @default(ACTIVE)
  stripeCustomerId     String?             @unique
  preferredAiProvider  String?
  allowPremiumAi       Boolean             @default(false)
  apiKey               String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  emailVerifiedAt      DateTime?
  transactions         CreditTransaction[]
  purchaseTransactions Transaction[]
  creditUsages         CreditUsage[]
  aiUsageLogs          AiUsageLog[]
  subscriptions        Subscription[]
  videoProjects        VideoProject[]
  mediaAssets          MediaAsset[]
  generationTasks      GenerationTask[]
  tokenUsages          TokenUsage[]
  consentRecords       ConsentRecord[]
  authSessions         AuthSession[]
  montageJobs          MontageJob[]
  systemTestRuns       SystemTestRun[]
  clipWorkerJobs       ClipWorkerJob[]
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  email           String
  requestedName   String?
  tokenHash       String    @unique
  requestedIpHash String
  expiresAt       DateTime
  usedAt          DateTime?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  createdAt       DateTime  @default(now())

  @@index([email, createdAt])
  @@index([requestedIpHash, createdAt])
}

model AuthSession {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuthThrottle {
  id           String    @id @default(cuid())
  keyHash      String
  action       String
  windowStart  DateTime
  attempts     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([keyHash, action])
  @@index([blockedUntil])
}

model ApiIdempotency {
  id           String   @id @default(cuid())
  scope        String
  ownerKey     String
  keyHash      String
  status       String   @default("PROCESSING")
  response     Json?
  responseCode Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, ownerKey, keyHash])
  @@index([expiresAt])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  videoType String
  objective String
  deadline  String?
  budget    String?
  filesNote String?
  message   String?
  ipHash    String
  status    String   @default("RECEIVED")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

model Transaction {
  id              String            @id @default(cuid())
  user            User              @relation(fields: [userId], references: [id])
  userId          String
  stripeSessionId String            @unique
  amount          Int
  tokens          Int
  status          TransactionStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([userId, createdAt])
}

model CreditUsage {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  amount        Int
  reason        String
  metadata      Json?
  reservationId String?  @unique
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model CreditTransaction {
  id             String            @id @default(cuid())
  user           User              @relation(fields: [userId], references: [id])
  userId         String
  type           TransactionType
  action         CreditAction
  creditsAmount  Int
  description    String
  metadata       Json?
  idempotencyKey String?           @unique
  providerTaskId String?
  status         TransactionStatus @default(PENDING)
  confirmedAt    DateTime?
  refundedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AiUsageLog {
  id                    String       @id @default(cuid())
  user                  User         @relation(fields: [userId], references: [id])
  userId                String
  provider              String
  model                 String
  action                CreditAction
  quality               String?
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?
  estimatedCost         Float?
  creditsCharged        Int
  success               Boolean      @default(true)
  errorMessage          String?
  createdAt             DateTime     @default(now())
}

model Subscription {
  id                   String        @id @default(cuid())
  user                 User          @relation(fields: [userId], references: [id])
  userId               String
  stripeSubscriptionId String        @unique
  priceId              String
  plan                 UserPlan
  status               BillingStatus
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model StripeWebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  status        String    @default("PROCESSING")
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}

model SubscriptionCreditGrant {
  id                   String    @id @default(cuid())
  invoiceId            String    @unique
  stripeSubscriptionId String
  userId               String
  credits              Int
  periodStart          DateTime?
  periodEnd            DateTime?
  createdAt            DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([stripeSubscriptionId, createdAt])
}

model ProductPlan {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  monthlyPriceCents   Int
  includedGenerations Int
  includedCredits     Int
  allowPremiumAi      Boolean  @default(false)
  maxProjects         Int      @default(1)
  stripePriceId       String?  @unique
  description         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CreditPack {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  priceCents    Int
  credits       Int
  stripePriceId String?  @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminSubject String
  action       String
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

model VideoProject {
  id                       String             @id @default(cuid())
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String
  title                    String
  artistName               String
  musicGenre               String?
  bpm                      Int?
  durationSeconds          Int?
  finalFormat              String             @default("16:9")
  summary                  String?
  mood                     String?
  visualStyle              String?
  locations                Json?
  colors                   Json?
  cameraMovements          Json?
  status                   VideoProjectStatus @default(DRAFT)
  clipPlan                 ClipPlan?
  paymentCompletedAt       DateTime?
  demoMode                 Boolean            @default(false)
  source                   String             @default("USER")
  billingMode              String             @default("BILLABLE")
  maxBudgetUsd             Float?
  maxBudgetCredits         Int?
  creditReservationId      String?            @unique
  audioStartSeconds        Float              @default(0)
  billedDurationSeconds    Float?
  clientRevenueEur         Float?
  estimatedProviderCostEur Float?
  actualProviderCostEur    Float?
  estimatedMarginEur       Float?
  actualMarginEur          Float?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  artistIdentity           ArtistIdentity?
  mediaAssets              MediaAsset[]
  scenes                   StoryboardScene[]
  generationTasks          GenerationTask[]
  tokenUsages              TokenUsage[]
  budgetLimit              BudgetLimit?
  finalExports             FinalExport[]
  consentRecords           ConsentRecord[]
  montageJobs              MontageJob[]
  systemTestRun            SystemTestRun?
  clipWorkerJobs           ClipWorkerJob[]

  @@index([userId, updatedAt])
  @@index([clipPlan, status])
}

model ArtistIdentity {
  id                  String       @id @default(cuid())
  project             VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId           String       @unique
  physicalDescription String?
  hairstyle           String?
  mainOutfit          String?
  accessories         Json?
  colorPalette        Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model MediaAsset {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  project    VideoProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  type       MediaAssetType
  fileName   String
  storageKey String         @unique
  url        String
  mimeType   String
  sizeBytes  Int
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([projectId, type])
  @@index([userId, createdAt])
}

model StoryboardScene {
  id                String                @id @default(cuid())
  project           VideoProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  order             Int
  title             String
  startTimeSeconds  Float
  endTimeSeconds    Float
  durationSeconds   Int
  prompt            String
  negativePrompt    String?
  mood              String?
  location          String?
  cameraMovement    String?
  modelId           String?
  resolution        String                @default("720p")
  ratio             String                @default("16:9")
  variantsRequested Int                   @default(1)
  seed              Int?
  cameraFixed       Boolean               @default(false)
  generateAudio     Boolean               @default(false)
  watermark         Boolean               @default(false)
  locked            Boolean               @default(false)
  status            StoryboardSceneStatus @default(DRAFT)
  selectedVariantId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  generationTasks   GenerationTask[]
  variants          GenerationVariant[]
  tokenUsages       TokenUsage[]

  @@unique([projectId, order])
  @@index([projectId, status])
}

model GenerationTask {
  id                     String               @id @default(cuid())
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  project                VideoProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  scene                  StoryboardScene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId                String
  bytePlusTaskId         String?              @unique
  idempotencyKey         String               @unique
  provider               String               @default("byteplus")
  source                 String               @default("USER")
  billingMode            String               @default("BILLABLE")
  modelId                String
  status                 GenerationTaskStatus @default(PENDING)
  requestPayload         Json
  responsePayload        Json?
  errorCode              String?
  errorMessage           String?
  estimatedCredits       Int                  @default(0)
  estimatedTokens        Int?
  actualCompletionTokens Int?
  estimatedCostUsd       Float?
  actualCostUsd          Float?
  sourceVideoUrl         String?
  permanentVideoUrl      String?
  thumbnailUrl           String?
  creditReservationId    String?              @unique
  lastPolledAt           DateTime?
  completedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  variants               GenerationVariant[]
  tokenUsage             TokenUsage?

  @@index([userId, createdAt])
  @@index([projectId, status])
  @@index([sceneId, createdAt])
}

model GenerationVariant {
  id              String          @id @default(cuid())
  task            GenerationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  scene           StoryboardScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId         String
  variantNumber   Int
  videoUrl        String
  thumbnailUrl    String?
  durationSeconds Int?
  selected        Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([taskId, variantNumber])
  @@index([sceneId, selected])
}

model TokenUsage {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  project          VideoProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  scene            StoryboardScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId          String
  task             GenerationTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId           String          @unique
  modelId          String
  completionTokens Int
  costUsd          Float?
  costEur          Float?
  creditsCharged   Int
  createdAt        DateTime        @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model BudgetLimit {
  id                   String       @id @default(cuid())
  project              VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId            String       @unique
  perGenerationCredits Int?
  projectCredits       Int?
  dailyCredits         Int?
  monthlyCredits       Int?
  projectUsd           Float?
  alertThresholds      Json         @default("[50,75,90]")
  blockAtPercent       Int          @default(100)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model FinalExport {
  id            String            @id @default(cuid())
  project       VideoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  status        FinalExportStatus @default(DRAFT)
  format        String
  resolution    String
  storageKey    String?
  url           String?
  errorMessage  String?
  settings      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  montageJob    MontageJob?
  clipWorkerJob ClipWorkerJob?

  @@index([projectId, createdAt])
}

model MontageJob {
  id             String            @id @default(cuid())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  project        VideoProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  finalExport    FinalExport       @relation(fields: [finalExportId], references: [id], onDelete: Cascade)
  finalExportId  String            @unique
  generationId   String
  status         MontageJobStatus  @default(QUEUED)
  progress       Int               @default(0)
  inputManifest  Json
  outputPath     String
  errorCode      String?
  errorMessage   String?
  attemptCount   Int               @default(0)
  maxAttempts    Int               @default(3)
  idempotencyKey String            @unique
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  availableAt    DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         MontageJobEvent[]

  @@index([status, availableAt, createdAt])
  @@index([projectId, status])
  @@index([leaseExpiresAt])
}

model MontageJobEvent {
  id        String           @id @default(cuid())
  job       MontageJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  status    MontageJobStatus
  progress  Int
  message   String
  createdAt DateTime         @default(now())

  @@index([jobId, createdAt])
}

model ClipWorkerJob {
  id             String               @id
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  project        VideoProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  finalExport    FinalExport          @relation(fields: [finalExportId], references: [id], onDelete: Cascade)
  finalExportId  String               @unique
  status         ClipWorkerJobStatus  @default(QUEUED)
  progress       Int                  @default(0)
  inputManifest  Json
  outputPath     String
  attemptCount   Int                  @default(0)
  maxAttempts    Int                  @default(3)
  idempotencyKey String               @unique
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  availableAt    DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  events         ClipWorkerJobEvent[]

  @@index([status, availableAt, createdAt])
  @@index([projectId, status])
  @@index([leaseExpiresAt])
}

model ClipWorkerJobEvent {
  id        String              @id @default(cuid())
  job       ClipWorkerJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  status    ClipWorkerJobStatus
  progress  Int
  message   String
  createdAt DateTime            @default(now())

  @@index([jobId, createdAt])
}

model WorkerHeartbeat {
  id                 String             @id
  version            String
  status             WorkerHealthStatus @default(ONLINE)
  lastSeenAt         DateTime           @default(now())
  currentJobId       String?
  ffmpegAvailable    Boolean            @default(false)
  databaseAvailable  Boolean            @default(false)
  storageAvailable   Boolean            @default(false)
  tempAvailableBytes BigInt?
  errorCode          String?
  startedAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([lastSeenAt])
  @@index([status, lastSeenAt])
}

model SystemTestRun {
  id                   String             @id @default(cuid())
  adminSubject         String
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               String?
  project              VideoProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId            String?            @unique
  montageJobId         String?            @unique
  finalExportId        String?            @unique
  source               String             @default("SYSTEM_TEST")
  billingMode          String             @default("NON_BILLABLE")
  provider             String             @default("TEST_FIXTURE")
  scenario             SystemTestScenario @default(SUCCESS)
  status               SystemTestStatus   @default(PREPARING)
  steps                Json               @default("[]")
  diagnostics          Json?
  balanceBefore        Int
  balanceAfter         Int?
  billingVerified      Boolean            @default(false)
  bytePlusCallVerified Boolean            @default(false)
  outputPath           String?
  downloadTokenHash    String?
  downloadExpiresAt    DateTime?
  expiresAt            DateTime
  completedAt          DateTime?
  cleanedAt            DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([expiresAt, cleanedAt])
  @@index([adminSubject, createdAt])
}

model ConsentRecord {
  id                String       @id @default(cuid())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  project           VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  personName        String
  authorizationType String
  consentedAt       DateTime
  documentAssetId   String?
  notes             String?
  createdAt         DateTime     @default(now())

  @@index([projectId, consentedAt])
  @@index([userId, createdAt])
}
